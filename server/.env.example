PORT=8787
# SQLite file. Created on startup. Relative to the server directory.
DATABASE_PATH=./data/tradeagotchi.db

# sample (offline, default) | yahoo | alpaca | polygon
MARKET_DATA_PROVIDER=sample

# Yahoo needs no key. It calls the public chart endpoint with a browser user-agent.
# YAHOO_RANGE=5y

# Alpaca market data. Paper keys are fine; this server never sends orders.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
# ALPACA_DATA_URL=https://data.alpaca.markets
# ALPACA_FEED=iex

# Polygon.io aggregates.
# POLYGON_API_KEY=
